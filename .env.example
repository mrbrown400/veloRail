# Google Maps API Key (required)
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable for current web app:
# Maps JavaScript API, Routes API, Places API, Places API (New),
# Geocoding API, Maps Elevation API, Roads API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenRouteService API Key (optional, for enhanced bike routing)
# Get a free key at: https://openrouteservice.org/dev/#/signup
VITE_ORS_API_KEY=your_api_key_here

# Swiftly API (LA Metro real-time data)
# Get API key from your Swiftly dashboard
VITE_SWIFTLY_API_KEY=your_swiftly_api_key_here
# Optional: Override the default URLs
# VITE_SWIFTLY_TRIP_UPDATES_URL=https://api.goswift.ly/real-time/lametro-rail/gtfs-rt-trip-updates
# VITE_SWIFTLY_VEHICLE_POSITIONS_URL=https://api.goswift.ly/real-time/lametro-rail/gtfs-rt-vehicle-positions

# Metrolink GTFS-RT API
# Contact Metrolink for API access
VITE_METROLINK_API_KEY=your_metrolink_api_key_here
# VITE_METROLINK_VEHICLE_POSITIONS_URL=https://metrolink-gtfsrt.gbsdigital.us/feed/gtfsrt-vehicles
